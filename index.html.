            document.getElementById('modal-maneuver-title').innerText = `${currentLang === 'pt' ? 'Submeter Vídeo' : 'Upload Video'}: ${maneuver.title[currentLang]}`;
            
            document.getElementById('dropzone').classList.remove('hidden');
            document.getElementById('ai-processing').classList.add('hidden');
            document.getElementById('ai-result').classList.add('hidden');
            document.getElementById('btn-submit-ai').disabled = true;
            document.getElementById('video-file-input').value = '';

            document.getElementById('modal-ai-upload').classList.remove('hidden');
        }

        function closeAiModal() {
            document.getElementById('modal-ai-upload').classList.add('hidden');
        }

        function triggerFileInput() {
            document.getElementById('video-file-input').click();
        }

        function handleFileSelect(event) {
            const file = event.target.files[0];
            if (file) {
                document.getElementById('dropzone-txt-1').innerText = file.name;
                document.getElementById('dropzone-txt-2').innerText = `${(file.size / (1024 * 1024)).toFixed(1)} MB — ${currentLang === 'pt' ? 'Pronto para análise' : 'Ready for analysis'}`;
                document.getElementById('btn-submit-ai').disabled = false;
            }
        }

        function simulateAiAnalysis() {
            document.getElementById('dropzone').classList.add('hidden');
            document.getElementById('btn-submit-ai').disabled = true;
            document.getElementById('ai-processing').classList.remove('hidden');

            let progress = 0;
            const progressBar = document.getElementById('ai-progress-bar');
            const stepPct = document.getElementById('ai-step-pct');

            const interval = setInterval(() => {
                progress += 15;
                if (progress > 100) progress = 100;

                progressBar.style.width = `${progress}%`;
                stepPct.innerText = `${progress}%`;

                if (progress === 100) {
                    clearInterval(interval);
                    setTimeout(() => {
                        document.getElementById('ai-processing').classList.add('hidden');
                        document.getElementById('ai-result').classList.remove('hidden');

                        const maneuver = maneuversData.find(m => m.id === activeManeuverId);
                        if (maneuver) {
                            maneuver.progress = 100;
                            renderManeuvers();
                            calculateOverallProgress();
                        }
                    }, 500);
                }
            }, 300);
        }

        function toggleLanguage(lang) {
            currentLang = lang;
            document.getElementById('lang-btn-pt').className = lang === 'pt' ? 'px-2.5 py-1 text-xs font-semibold rounded-lg bg-ocean-600 text-white transition' : 'px-2.5 py-1 text-xs font-semibold rounded-lg bg-slate-800 text-slate-400 hover:text-white transition';
