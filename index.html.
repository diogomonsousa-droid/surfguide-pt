        // CÁLCULO DE PROGRESSO GERAL
        function calculateOverallProgress() {
            const total = maneuversData.length * 100;
            const currentSum = maneuversData.reduce((acc, m) => acc + m.progress, 0);
            const overallPct = Math.round((currentSum / total) * 100);

            document.getElementById('overall-percentage').innerText = `${overallPct}%`;
            document.getElementById('main-progress-bar').style.width = `${overallPct}%`;

            const completedCount = maneuversData.filter(m => m.progress === 100).length;
            document.getElementById('lbl-completed-count').innerText = currentLang === 'pt' 
                ? `${completedCount} de ${maneuversData.length} Manobras Dominadas`
                : `${completedCount} of ${maneuversData.length} Maneuvers Mastered`;
        }

