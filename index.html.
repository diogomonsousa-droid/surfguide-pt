<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SurfGuide PT — O Teu Guia Inteligente de Surf em Portugal</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ocean: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#06b6d4',
                            600: '#0891b2',
                            800: '#0e7490',
                            900: '#164e63',
                            950: '#082f49',
                        },
                        sand: '#fef3c7'
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Chart.js CDN para os Gráficos Avançados -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .progress-bar-fill {
            transition: width 0.8s ease-in-out;
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 font-sans min-h-screen pb-20">

    <!-- CABEÇALHO / HEADER -->
    <header class="bg-slate-950/80 backdrop-blur border-b border-slate-800 sticky top-0 z-50">
        <div class="max-w-4xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center gap-2">
                <div class="bg-ocean-600 p-2 rounded-xl text-white">
                    <i data-lucide="waves" class="w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight text-white flex items-center gap-1.5">
                        SurfGuide <span class="text-ocean-500 text-xs px-1.5 py-0.5 rounded bg-ocean-500/10 border border-ocean-500/20 font-mono">PT</span>
                    </h1>
                    <p class="text-xs text-slate-400" id="header-subtitle">Previsões & Comunitário em Portugal</p>
                </div>
            </div>

            <!-- SELETOR DE IDIOMA -->
            <div class="flex items-center gap-2">
                <button onclick="toggleLanguage('pt')" id="lang-btn-pt" class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-ocean-600 text-white transition">PT 🇵🇹</button>
                <button onclick="toggleLanguage('en')" id="lang-btn-en" class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-slate-800 text-slate-400 hover:text-white transition">EN 🇬🇧</button>
            </div>
        </div>
    </header>

    <!-- NAVEGAÇÃO PRINCIPAL (ABAS) -->
    <nav class="bg-slate-950 border-b border-slate-800 sticky top-[61px] z-40">
        <div class="max-w-4xl mx-auto px-2 flex justify-around text-xs font-medium">
            <button onclick="switchTab('forecast')" id="tab-forecast" class="flex-1 py-3 text-center border-b-2 border-ocean-500 text-ocean-500 flex flex-col items-center gap-1 transition">
                <i data-lucide="compass" class="w-4 h-4"></i>
                <span id="tab-txt-forecast">Previsão & Spots</span>
            </button>
            <button onclick="switchTab('maneuvers')" id="tab-maneuvers" class="flex-1 py-3 text-center border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex flex-col items-center gap-1 transition relative">
                <i data-lucide="trophy" class="w-4 h-4"></i>
                <span id="tab-txt-maneuvers">Escola de Manobras</span>
                <span class="absolute top-1 right-3 w-2 h-2 rounded-full bg-ocean-500 animate-pulse"></span>
            </button>
            <button onclick="switchTab('community')" id="tab-community" class="flex-1 py-3 text-center border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex flex-col items-center gap-1 transition">
                <i data-lucide="users" class="w-4 h-4"></i>
                <span id="tab-txt-community">Hub Comunitário</span>
            </button>
        </div>
    </nav>

    <main class="max-w-4xl mx-auto px-4 py-6">

        <!-- ABA 1: PREVISÃO & SPOTS -->
        <section id="sec-forecast" class="space-y-6">
            
            <!-- FILTROS -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 bg-slate-950/60 p-4 rounded-2xl border border-slate-800">
                <div>
                    <label class="block text-xs text-slate-400 mb-1" id="lbl-zone">Zona / Praia:</label>
                    <select id="select-zone" onchange="updateForecast()" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-ocean-500">
                        <option value="caparica">Margem Sul — Costa da Caparica</option>
                        <option value="carcavelos">Cascais — Carcavelos</option>
                        <option value="peniche">Centro — Peniche (Baleal / Supertubos)</option>
                        <option value="matosinhos">Norte — Matosinhos</option>
                        <option value="portocovo">Alentejo — Porto Covo</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1" id="lbl-level">Nível de Surf:</label>
                    <select id="select-level" onchange="updateForecast()" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-ocean-500">
                        <option value="beginner">Iniciante (Ondas pequenas / Protegido)</option>
                        <option value="intermediate" selected>Intermédio (1.0m - 1.5m / Formação)</option>
                        <option value="advanced">Avançado (1.5m+ / Picos Exigentes)</option>
                    </select>
                </div>
            </div>

            <!-- ALERTA RESPEITO LOCAL -->
            <div class="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-4 flex gap-3 items-start">
                <i data-lucide="shield-alert" class="w-5 h-5 text-amber-400 shrink-0 mt-0.5"></i>
                <div class="text-xs space-y-1">
                    <h4 class="font-bold text-amber-300" id="respect-title">Código de Conduta & Respeito no Pico</h4>
                    <p class="text-amber-200/80 leading-relaxed" id="respect-desc">Respeita sempre a prioridade de quem está mais fundo na onda. Evita rabeadas (drop-ins) e mantém a cortesia com os surfistas locais.</p>
                </div>
            </div>

            <!-- CARTÃO DE PREVISÃO PRINCIPAL -->
            <div class="bg-slate-950 border border-slate-800 rounded-2xl p-5 space-y-4">
                <div class="flex justify-between items-start">
                    <div>
                        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-ocean-500/20 text-ocean-400 border border-ocean-500/30" id="badge-spot-status">Spot Recomendado Hoje</span>
                        <h2 class="text-2xl font-bold text-white mt-2" id="spot-name">Praia do CDS — Costa da Caparica</h2>
                    </div>
                    <div class="text-right">
                        <span class="text-xs text-slate-400" id="lbl-confidence">Precisão Dados</span>
                        <div class="flex items-center gap-1 text-emerald-400 text-xs font-semibold mt-0.5">
                            <i data-lucide="check-circle-2" class="w-3.5 h-3.5"></i>
                            <span>94% (3 APIs + Crowd)</span>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
                    <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800/80 text-center">
                        <span class="text-xs text-slate-400 block mb-1" id="lbl-wave-height">Altura do Swell</span>
                        <span class="text-xl font-bold text-ocean-400" id="val-wave">1.2m - 1.5m</span>
                    </div>
                    <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800/80 text-center">
                        <span class="text-xs text-slate-400 block mb-1" id="lbl-wind">Vento</span>
                        <span class="text-xl font-bold text-emerald-400" id="val-wind">8 nós (Offshore)</span>
                    </div>
                    <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800/80 text-center">
                        <span class="text-xs text-slate-400 block mb-1" id="lbl-tide">Melhor Maré</span>
                        <span class="text-xl font-bold text-amber-400" id="val-tide">Vaza (14:30)</span>
                    </div>
                    <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800/80 text-center">
                        <span class="text-xs text-slate-400 block mb-1" id="lbl-temp">Água</span>
                        <span class="text-xl font-bold text-cyan-400" id="val-temp">16°C (Fato 3/2mm)</span>
                    </div>
                </div>

                <!-- BOTÃO PARA MODO EXPERT / VER GRÁFICO COMPLETO -->
                <div class="pt-2 flex justify-between items-center border-t border-slate-800/80">
                    <div class="text-xs text-slate-400">
                        <span id="txt-triangulation">Triangulação: <b>Open-Meteo</b> + <b>Stormglass</b> + <b>IPMA</b></span>
                    </div>
                    <button onclick="toggleAdvancedGraph()" id="btn-toggle-graph" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-ocean-600/20 hover:bg-ocean-600/30 text-ocean-400 border border-ocean-500/30 flex items-center gap-1.5 transition">
                        <i data-lucide="line-chart" class="w-4 h-4"></i>
                        <span id="txt-btn-graph">Ver Gráficos Avançados (Modo Pro)</span>
                    </button>
                </div>

                <!-- SECÇÃO DO GRÁFICO AVANÇADO (EXPANSÍVEL) -->
                <div id="advanced-graph-panel" class="pt-4 border-t border-slate-800 space-y-4 hidden">
                    <div class="flex justify-between items-center">
                        <div>
                            <h4 class="text-sm font-bold text-white flex items-center gap-2" id="graph-panel-title">
                                <i data-lucide="activity" class="w-4 h-4 text-ocean-400"></i>
                                Previsão Detalhada de 24 Horas (Swell, Período & Vento)
                            </h4>
                            <p class="text-xs text-slate-400" id="graph-panel-desc">Análise técnica por hora para surfistas experientes.</p>
                        </div>
                        <div class="flex gap-2">
                            <span class="text-[10px] bg-slate-900 text-ocean-400 px-2 py-1 rounded border border-slate-800 flex items-center gap-1">
                                <span class="w-2 h-2 rounded-full bg-ocean-500"></span> Swell (m)
                            </span>
                            <span class="text-[10px] bg-slate-900 text-emerald-400 px-2 py-1 rounded border border-slate-800 flex items-center gap-1">
                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span> Período (s)
                            </span>
                        </div>
                    </div>

                    <!-- CANVAS DO GRÁFICO -->
                    <div class="bg-slate-900/90 p-4 rounded-xl border border-slate-800 relative h-64 w-full">
                        <canvas id="surfForecastChart"></canvas>
                    </div>

                    <!-- TABELA DE DADOS DE VENTO E DIREÇÃO (DADOS AVANÇADOS) -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs text-slate-300">
                            <thead class="bg-slate-900/80 text-slate-400 border-b border-slate-800 text-[11px]">
                                <tr>
                                    <th class="p-2" id="th-hour">Hora</th>
                                    <th class="p-2" id="th-swell">Swell (m)</th>
                                    <th class="p-2" id="th-period">Período (s)</th>
                                    <th class="p-2" id="th-wind-dir">Direção Vento</th>
                                    <th class="p-2" id="th-tide-state">Estado Maré</th>
                                </tr>
                            </thead>
                            <tbody id="tech-forecast-tbody" class="divide-y divide-slate-800/50 font-mono text-[11px]">
                                <!-- Preenchido dinamicamente via JavaScript -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <!-- LOJAS E ESCOLAS LOCAIS -->
            <div class="space-y-3">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <i data-lucide="store" class="w-5 h-5 text-ocean-500"></i>
                    <span id="title-shops">Surf Shops & Escolas Recomendadas na Praia</span>
                </h3>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="shops-list">
                    <!-- Gerado Dinamicamente -->
                </div>
            </div>

        </section>

        <!-- ABA 2: ESCOLA DE MANOBRAS & AVALIAÇÃO DE IA -->
        <section id="sec-maneuvers" class="space-y-6 hidden">

            <!-- QUADRO DE PROGRESSO DO SURFISTA -->
            <div class="bg-slate-950 border border-slate-800 rounded-2xl p-5 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <i data-lucide="award" class="w-6 h-6 text-amber-400"></i>
                            <span id="prog-title">O Teu Nível Teórico & Prático</span>
                        </h2>
                        <p class="text-xs text-slate-400" id="prog-subtitle">Acompanha as manobras dominadas e validadas por IA.</p>
                    </div>
                    <div class="text-right">
                        <span class="text-2xl font-black text-ocean-400" id="overall-percentage">33%</span>
                        <span class="text-xs text-slate-400 block" id="lbl-completed-count">2 de 6 Manobras Dominadas</span>
                    </div>
                </div>

                <!-- BARRA GERAL DE PROGRESSO DA CONTA -->
                <div class="w-full bg-slate-900 rounded-full h-3 overflow-hidden border border-slate-800">
                    <div id="main-progress-bar" class="bg-gradient-to-r from-ocean-600 to-emerald-400 h-full progress-bar-fill" style="width: 33%;"></div>
                </div>

                <!-- PRIVACIDADE & PRIVADO -->
                <div class="flex items-center gap-2 text-xs text-slate-400 bg-slate-900/60 p-2.5 rounded-xl border border-slate-800">
                    <i data-lucide="lock" class="w-4 h-4 text-emerald-400 shrink-0"></i>
                    <span id="txt-privacy"><b>Privacidade Total:</b> Os vídeos submetidos para validação por IA são processados em modo privado e não ficam visíveis para nenhum outro utilizador.</span>
                </div>
            </div>

            <!-- LISTA DE MANOBRAS E BARRAS INDIVIDUAIS -->
            <div class="space-y-4" id="maneuvers-list">
                <!-- Conteúdo Gerado Dinamicamente via JS -->
            </div>

        </section>

        <!-- ABA 3: HUB COMUNITÁRIO -->
        <section id="sec-community" class="space-y-6 hidden">
            
            <div class="flex justify-between items-center">
                <div>
                    <h2 class="text-xl font-bold text-white" id="comm-title">Feed da Comunidade de Surf</h2>
                    <p class="text-xs text-slate-400" id="comm-subtitle">Relatórios reais de quem acabou de sair da água.</p>
                </div>
                <button onclick="openSessionModal()" class="bg-ocean-600 hover:bg-ocean-500 text-white text-xs font-semibold px-4 py-2 rounded-xl flex items-center gap-1.5 transition">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i>
                    <span id="btn-log-session">Registar Sessão</span>
                </button>
            </div>

            <!-- FEED DE SESSÕES -->
            <div class="space-y-4" id="feed-container">
                <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4 space-y-3">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-full bg-ocean-600 flex items-center justify-center font-bold text-xs text-white">TM</div>
                            <div>
                                <h4 class="text-xs font-bold text-white">Tiago M.</h4>
                                <span class="text-[10px] text-slate-400">Praia do CDS (Caparica) • Há 25 min</span>
                            </div>
                        </div>
                        <span class="text-xs px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-semibold">1h 45m na água</span>
                    </div>
                    <p class="text-xs text-slate-300">"Swell a entrar com boa força na maré vaza. Vento offshore perfeito até às 11h. Pouco crowd no pico do meio!"</p>
                    <div class="grid grid-cols-3 gap-2 text-center text-[11px] bg-slate-900/60 p-2 rounded-xl">
                        <div><span class="text-slate-400 block" id="lbl-real-wave">Onda Real</span> <b class="text-ocean-400">1.5m</b></div>
                        <div><span class="text-slate-400 block" id="lbl-crowd">Crowd</span> <b class="text-emerald-400">Baixo</b></div>
                        <div><span class="text-slate-400 block" id="lbl-rating">Nota</span> <b class="text-amber-400">4.5 / 5 ★</b></div>
                    </div>
                </div>

                <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4 space-y-3">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-full bg-purple-600 flex items-center justify-center font-bold text-xs text-white">JG</div>
                            <div>
                                <h4 class="text-xs font-bold text-white">Joana G.</h4>
                                <span class="text-[10px] text-slate-400">Supertubos (Peniche) • Há 2 horas</span>
                            </div>
                        </div>
                        <span class="text-xs px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-semibold">2h 10m na água</span>
                    </div>
                    <p class="text-xs text-slate-300">"Tubos rápidos e pesados. Recomendo apenas para pessoal avançado hoje. Muito respeito no pico com os locais."</p>
                    <div class="grid grid-cols-3 gap-2 text-center text-[11px] bg-slate-900/60 p-2 rounded-xl">
                        <div><span class="text-slate-400 block">Onda Real</span> <b class="text-ocean-400">2.0m</b></div>
                        <div><span class="text-slate-400 block">Crowd</span> <b class="text-amber-400">Médio</b></div>
                        <div><span class="text-slate-400 block">Nota</span> <b class="text-amber-400">5.0 / 5 ★</b></div>
                    </div>
                </div>
            </div>

        </section>

    </main>

    <!-- MODAL DE UPLOAD DE VÍDEO & ANÁLISE POR IA -->
    <div id="modal-ai-upload" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 space-y-5 shadow-2xl relative">
            <button onclick="closeAiModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <div class="space-y-1">
                <div class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-ocean-500/10 text-ocean-400 border border-ocean-500/20">
                    <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                    <span>Verificação Privada por IA</span>
                </div>
                <h3 class="text-lg font-bold text-white" id="modal-maneuver-title">Submeter Vídeo: Cutback</h3>
                <p class="text-xs text-slate-400" id="modal-maneuver-desc">Carrega um vídeo curto da tua manobra na água. A IA irá analisar o movimento dos teus ombros, apoio dos pés e linha da prancha.</p>
            </div>

            <!-- DROPZONE DE VÍDEO -->
            <div id="dropzone" onclick="triggerFileInput()" class="border-2 border-dashed border-slate-700 hover:border-ocean-500/50 bg-slate-950/50 rounded-2xl p-6 text-center cursor-pointer transition space-y-2">
                <input type="file" id="video-file-input" accept="video/*" class="hidden" onchange="handleFileSelect(event)">
                <div class="w-12 h-12 bg-ocean-600/20 text-ocean-400 rounded-full flex items-center justify-center mx-auto">
                    <i data-lucide="video" class="w-6 h-6"></i>
                </div>
                <div class="text-xs">
                    <span class="font-semibold text-white block" id="dropzone-txt-1">Clica para carregar o vídeo</span>
                    <span class="text-slate-500 block" id="dropzone-txt-2">MP4, MOV até 50MB (Fica 100% Privado)</span>
                </div>
            </div>

            <!-- ANIMAÇÃO DE PROCESSAMENTO DE IA -->
            <div id="ai-processing" class="space-y-3 hidden">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-ocean-400 font-semibold flex items-center gap-1.5">
                        <i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i>
                        <span id="txt-analyzing">IA a analisar rotação do tronco e angulação...</span>
                    </span>
                    <span class="text-slate-400" id="ai-step-pct">68%</span>
                </div>
                <div class="w-full bg-slate-950 rounded-full h-2 overflow-hidden border border-slate-800">
                    <div id="ai-progress-bar" class="bg-ocean-500 h-full w-0 transition-all duration-300"></div>
                </div>
            </div>

            <!-- RESULTADO DA ANÁLISE -->
            <div id="ai-result" class="bg-emerald-500/10 border border-emerald-500/30 p-4 rounded-xl space-y-2 hidden">
                <div class="flex items-center gap-2 text-emerald-400 font-bold text-sm">
                    <i data-lucide="check-circle" class="w-5 h-5"></i>
                    <span id="res-success-title">Manobra Validada com Sucesso!</span>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed" id="res-success-desc">A IA detetou uma rotação completa de 180° com boa transição de bordos e peso no pé da retaguarda. Parabéns, a tua barra de progresso foi atualizada para 100%!</p>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button onclick="closeAiModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-400 hover:text-white" id="btn-cancel">Cancelar</button>
                <button id="btn-submit-ai" onclick="simulateAiAnalysis()" class="px-4 py-2 rounded-xl text-xs font-semibold bg-ocean-600 hover:bg-ocean-500 text-white transition flex items-center gap-1.5" disabled>
                    <i data-lucide="cpu" class="w-4 h-4"></i>
                    <span id="btn-start-analysis">Iniciar Análise Privada</span>
                </button>
            </div>
        </div>
    </div>

    <!-- DICIONÁRIO DE DADOS & SCRIPT JS -->
    <script>
        // ESTADO GLOBAL DA APLICAÇÃO
        let currentLang = 'pt';
        let activeManeuverId = null;
        let forecastChart = null;
        let isGraphOpen = false;

        // DADOS TÉCNICOS HORÁRIOS PARA O GRÁFICO AVANÇADO (PRO)
        const hourlyForecastData = {
            caparica: [
                { time: '06:00', swell: 1.1, period: 10, wind: '6 nós E (Offshore)', tide: 'Enche (1.8m)' },
                { time: '09:00', swell: 1.3, period: 11, wind: '8 nós ESE (Offshore)', tide: 'Preia-mar (2.4m)' },
                { time: '12:00', swell: 1.5, period: 12, wind: '10 nós NNE (Cross-off)', tide: 'Vaza (1.6m)' },
